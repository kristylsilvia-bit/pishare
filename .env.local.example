# ── Hermes Agent API ──────────────────────────────────────────────────────────
# Public URL of your Hermes Agent's OpenAI-compatible API (IP or DDNS host + port).
# Update the host if your home IP changes (see README → "If your home IP changes").
HERMES_API_URL=http://104.229.7.78:8642

# Bearer token for the Hermes API server — must match API_SERVER_KEY in
# ~/.hermes/.env on the Pi. Required once the agent's API server is enabled.
HERMES_API_KEY=change-me-local-dev

# ── Hermes Config Server (the Express app in /config-server, runs on the Pi) ────
HERMES_CONFIG_URL=http://104.229.7.78:8643

# Must match CONFIG_KEY in config-server/.env on the Pi.
HERMES_CONFIG_KEY=changeme
