# Shared secret — must match HERMES_CONFIG_KEY in the Next.js app (Vercel env).
CONFIG_KEY=changeme

# Port the config server listens on (forward this one on your router).
PORT=8643

# Optional: override the config file location.
# Defaults to ~/.hermes/config.yaml for the user running the service.
# CONFIG_PATH=/home/pi/.hermes/config.yaml
